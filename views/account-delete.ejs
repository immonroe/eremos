<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= title %></title>
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <div class="app-container">
    <aside class="sidebar">
      <div class="sidebar-header">
        <div class="sidebar-logo">
          <h1>Eremos</h1>
          <p class="tagline">Find your oasis</p>
        </div>
      </div>
      <nav class="sidebar-nav">
        <a href="/profile" class="nav-link"><i class="fas fa-book-open"></i><span>Journal</span></a>
        <a href="/bookmarks" class="nav-link"><i class="fas fa-bookmark"></i><span>Bookmarks</span></a>
        <a href="/activity" class="nav-link"><i class="fas fa-chart-line"></i><span>Activity</span></a>
        <a href="/settings" class="nav-link"><i class="fas fa-cog"></i><span>Settings</span></a>
      </nav>
      <div class="sidebar-footer">
        <a href="/profile" class="logout-btn"><i class="fas fa-arrow-left"></i><span>Back to Journal</span></a>
      </div>
    </aside>
    <main class="main-content">
      <div class="content">
        <div class="content-header">
          <h2><i class="fas fa-user-times"></i> Delete account</h2>
          <% if (locals.error && error.length > 0) { %>
            <div class="alert alert-danger"><%= error %></div>
          <% } %>
          <p>Permanently delete your account and all journal entries. This cannot be undone.</p>
        </div>
        <div class="card">
          <div class="card-body">
            <form action="/account/delete" method="POST">
              <div class="form-group">
                <label>
                  <input type="checkbox" name="confirmCheckbox" value="true" required>
                  I understand that my account and all my journal entries will be permanently deleted.
                </label>
              </div>
              <div class="form-group">
                <label for="confirmText">Type <strong>DELETE</strong> to confirm:</label>
                <input type="text" id="confirmText" name="confirmText" class="form-control" placeholder="DELETE" required autocomplete="off">
              </div>
              <div class="card-actions">
                <a href="/profile" class="btn btn-secondary">Cancel</a>
                <button type="submit" class="btn btn-danger">Permanently delete my account</button>
              </div>
            </form>
          </div>
        </div>
      </div>
    </main>
  </div>
</body>
</html>
